{
  "frameRate": 24,
  "name": "Arctron",
  "version": "5.5",
  "compatibleVersion": "5.5",
  "armature": [{
    "name": "Armature",
    "aabb": { "x": -100, "y": -200, "width": 200, "height": 400 },
    "bone": [
      { "name": "root" },
      { "name": "body", "parent": "root", "transform": { "y": -100 } },
      { "name": "head", "parent": "body", "transform": { "y": -80 } },
      { "name": "armL", "parent": "body", "transform": { "x": -40, "y": -60 } },
      { "name": "armR", "parent": "body", "transform": { "x": 40, "y": -60 } },
      { "name": "legL", "parent": "root", "transform": { "x": -20 } },
      { "name": "legR", "parent": "root", "transform": { "x": 20 } }
    ],
    "slot": [
      { "name": "body", "parent": "body" },
      { "name": "head", "parent": "head" },
      { "name": "armL", "parent": "armL" },
      { "name": "armR", "parent": "armR" },
      { "name": "legL", "parent": "legL" },
      { "name": "legR", "parent": "legR" }
    ],
    "skin": [{
      "name": "",
      "slot": [
        { "name": "body",  "display": [{ "name": "body",  "type": "image", "path": "body" }] },
        { "name": "head",  "display": [{ "name": "head",  "type": "image", "path": "head" }] },
        { "name": "armL",  "display": [{ "name": "armL",  "type": "image", "path": "armL" }] },
        { "name": "armR",  "display": [{ "name": "armR",  "type": "image", "path": "armR" }] },
        { "name": "legL",  "display": [{ "name": "legL",  "type": "image", "path": "legL" }] },
        { "name": "legR",  "display": [{ "name": "legR",  "type": "image", "path": "legR" }] }
      ]
    }],
    "animation": [
      {
        "name": "idle",
        "duration": 48,
        "playTimes": 0,
        "bone": [
          {
            "name": "body",
            "translateFrame": [
              { "duration": 24, "tweenEasing": 0, "y": -100 },
              { "duration": 24, "tweenEasing": 0, "y": -105 }
            ]
          },
          {
            "name": "head",
            "translateFrame": [
              { "duration": 24, "tweenEasing": 0, "y": -80 },
              { "duration": 24, "tweenEasing": 0, "y": -82 }
            ]
          }
        ]
      },
      {
        "name": "walk",
        "duration": 24,
        "playTimes": 0,
        "bone": [
          {
            "name": "legL",
            "rotateFrame": [
              { "duration": 6, "tweenEasing": 0, "rotate": -20 },
              { "duration": 6, "tweenEasing": 0, "rotate": 0 },
              { "duration": 6, "tweenEasing": 0, "rotate": 20 },
              { "duration": 6, "tweenEasing": 0, "rotate": 0 }
            ]
          },
          {
            "name": "legR",
            "rotateFrame": [
              { "duration": 6, "tweenEasing": 0, "rotate": 20 },
              { "duration": 6, "tweenEasing": 0, "rotate": 0 },
              { "duration": 6, "tweenEasing": 0, "rotate": -20 },
              { "duration": 6, "tweenEasing": 0, "rotate": 0 }
            ]
          },
          {
            "name": "armL",
            "rotateFrame": [
              { "duration": 6, "tweenEasing": 0, "rotate": 15 },
              { "duration": 6, "tweenEasing": 0, "rotate": 0 },
              { "duration": 6, "tweenEasing": 0, "rotate": -15 },
              { "duration": 6, "tweenEasing": 0, "rotate": 0 }
            ]
          },
          {
            "name": "armR",
            "rotateFrame": [
              { "duration": 6, "tweenEasing": 0, "rotate": -15 },
              { "duration": 6, "tweenEasing": 0, "rotate": 0 },
              { "duration": 6, "tweenEasing": 0, "rotate": 15 },
              { "duration": 6, "tweenEasing": 0, "rotate": 0 }
            ]
          }
        ]
      },
      {
        "name": "attack",
        "duration": 12,
        "playTimes": 1,
        "bone": [
          {
            "name": "armR",
            "rotateFrame": [
              { "duration": 4, "tweenEasing": 0, "rotate": -60 },
              { "duration": 4, "tweenEasing": 0, "rotate": 90 },
              { "duration": 4, "tweenEasing": 0, "rotate": 0 }
            ]
          }
        ]
      }
    ],
    "defaultActions": [{ "gotoAndPlay": "idle" }]
  }]
}
